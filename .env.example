# Copy to the environment (never into git).
# Keys stay in the environment, not in config.toml.

# openai | anthropic | gemini
EASY_PROVIDER=gemini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: skip the per-search “send snippets?” prompt (scripts / CI)
# EASY_YES=1

# Unsupported: allow euid 0. sudo is always refused.
# EASY_ALLOW_ROOT=1

# Optional: point adapters at a mock or proxy (used by integration tests)
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080
# GEMINI_BASE_URL=http://127.0.0.1:8080
